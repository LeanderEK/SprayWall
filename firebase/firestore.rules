rules_version = '2';

// The rules of SprayWall's shared database. Paste all of this into Firebase console -> Firestore Database -> Rules -> Publish.
//
// The database holds boards. A board is found only by its code (16 random letters and digits, so nobody can guess one),
// and boards cannot be listed. Whoever knows a board's code may read its climbs and ADD new ones.
// Nobody can change or delete a climb once it is there (there is no update or delete rule at all), and nobody can
// change or delete a board. Every climb is checked for the right fields, types and sizes, and its `serverTime` has
// to be the database's own clock. The climb's id is the name of its document.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validClimb(d, id) {
      return d.keys().hasOnly(['name', 'grade', 'comment', 'author', 'holds', 'createdAt', 'serverTime'])
        && d.keys().hasAll(['name', 'author', 'holds', 'createdAt', 'serverTime'])
        && id.matches('[A-Za-z0-9_-]{8,64}')
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.author is string && d.author.size() >= 2 && d.author.size() <= 40
        && d.holds is string && d.holds.size() <= 20000
        && d.holds.matches('[0-9]+:(start|hand|foot|finish)(,[0-9]+:(start|hand|foot|finish))*')
        && d.createdAt is int
        && d.serverTime == request.time
        && d.get('grade', 0) is int && d.get('grade', 0) >= 0 && d.get('grade', 0) <= 17
        && d.get('comment', '') is string && d.get('comment', '').size() <= 2000;
    }

    match /boards/{board} {
      allow get: if signedIn();
      allow create: if signedIn()
        && board.matches('[a-z2-9]{16}')
        && request.resource.data.keys().hasOnly(['wallKey', 'wallName', 'createdAt'])
        && request.resource.data.wallKey is string && request.resource.data.wallKey.size() <= 80
        && request.resource.data.wallName is string && request.resource.data.wallName.size() <= 80
        && request.resource.data.createdAt is int;

      match /climbs/{climb} {
        allow get, list: if signedIn();
        allow create: if signedIn() && validClimb(request.resource.data, climb);
      }
    }
  }
}
